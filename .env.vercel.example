# Copy these keys into Vercel Project Settings -> Environment Variables.
# Do not commit real secrets. This file is only a safe template.

NEXT_PUBLIC_APP_NAME=NALCO Intelligence Bot
APP_BASE_URL=https://your-project.vercel.app

# Safe free-tier defaults. Turn these on only when you are ready to crawl live sources.
ENABLE_LIVE_INGEST=false
ENABLE_PAGE_LOAD_INGEST=false
GDELT_ENABLED=false
NALCO_MOCK_LIVE_SOURCES=true

# Optional persistence. Use the Supabase pooled PostgreSQL URL for runtime and
# the direct PostgreSQL URL for migrations. Do not use a Supabase personal access
# token here; it is for the Supabase Management API, not Prisma/RAG storage.
DATABASE_URL=
DIRECT_URL=

# Optional LLM answer formatting. Leave empty for deterministic grounded fallback answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# Optional source integrations.
NEWS_API_KEY=
COMMODITY_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Ingestion tuning.
SCRAPER_USER_AGENT=NALCO-Intelligence-Bot/1.0 (+public-demo)
INGEST_TIMEOUT_MS=12000
NALCO_CRAWL_CONCURRENCY=4
NALCO_CRAWL_MAX_PAGES=160
INGESTION_INTERVAL_MINUTES=5
